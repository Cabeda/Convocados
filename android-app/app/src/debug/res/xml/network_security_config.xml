<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) to the Android emulator's host loopback for local dev -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Real hardware: `adb reverse tcp:<port> tcp:<port>` exposes the host
             dev server on the device's own loopback, which is 127.0.0.1.
             10.0.2.2 only resolves inside the emulator. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
