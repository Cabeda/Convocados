{
  "name": "convocados",
  "version": "3.165.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "sh ./scripts/start.sh",
    "setup-hooks": "sh ./scripts/install-hooks.sh",
    "lint": "eslint src/",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:mutation": "node scripts/run-mutation.mjs",
    "test:route-coverage": "bash scripts/route-coverage.sh",
    "test:e2e": "npx playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "sh -c 'set -a; [ -f ./.env ] && . ./.env; set +a; PATH=\"$PWD/node_modules/.pnpm/node_modules/.bin:$PATH\" tsx prisma/seed.ts'",
    "db:seed:settle": "sh -c 'set -a; [ -f ./.env ] && . ./.env; set +a; PATH=\"$PWD/node_modules/.pnpm/node_modules/.bin:$PATH\" tsx prisma/seed-settle-demo.ts'",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "k6:smoke": "k6 run k6/scripts/smoke.js",
    "k6:load": "k6 run k6/scripts/load.js",
    "k6:stress": "k6 run k6/scripts/stress.js",
    "k6:spike": "k6 run k6/scripts/spike.js",
    "k6:sse": "k6 run k6/scripts/sse.js",
    "screenshots": "sh -c 'PATH=\"$PWD/node_modules/.pnpm/node_modules/.bin:$PATH\" tsx scripts/screenshots.ts'",
    "sync:i18n": "tsx scripts/generate-android-strings.ts",
    "sync:feature-parity-docs": "tsx scripts/generate-feature-parity-docs.ts",
    "db:seed:settlement": "sh -c 'set -a; [ -f ./.env ] && . ./.env; set +a; PATH=\"$PWD/node_modules/.pnpm/node_modules/.bin:$PATH\" tsx prisma/seed-settlement-demo.ts'"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@better-auth/oauth-provider": "^1.7.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.21.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "^1.7.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.6.0"
}
