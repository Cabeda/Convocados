---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventPageComponent from "../../components/EventPage";
import { prisma } from "../../lib/db.server";
import { activeParticipantsWhere } from "../../lib/activeParticipants.server";
import { generateEventHead, generateEventMetaTags } from "../../lib/seo";
import { buildEventSummary, type EventSummary } from "../../lib/eventSummary";

const { id } = Astro.params;

const host = Astro.request.headers.get("x-forwarded-host") ?? Astro.request.headers.get("host") ?? "convocados.fly.dev";
const proto = Astro.request.headers.get("x-forwarded-proto") ?? "https";
const canonicalUrl = `${proto}://${host}/events/${id}`;

let title = "Convocados";
let description = "Organize pickup sports games — manage events, randomize teams, track scores.";
let jsonLd = "";
let alternateJson: string | undefined;
let metaTags: { property: string; content: string }[] = [];
let summary: EventSummary | null = null;

try {
  const event = await prisma.event.findUnique({
    where: { id },
    select: {
      id: true, title: true, location: true, dateTime: true,
      sport: true, maxPlayers: true, isPublic: true, accessPassword: true,
      currentGameId: true,
      _count: { select: { players: true } },
    },
  });

  if (event) {
    // ADR 0016: the authoritative roster is GameParticipant-scoped once a
    // current Game exists; legacy Player rows are the fallback.
    const [playerNames, teamRows] = await Promise.all([
      event.currentGameId
        ? prisma.gameParticipant.findMany({
            where: activeParticipantsWhere(event.currentGameId),
            select: { eventPlayer: { select: { name: true } } },
            orderBy: { order: "asc" },
          }).then((rows) => rows.map((r) => r.eventPlayer.name))
        : prisma.player.findMany({
            where: { eventId: event.id, archivedAt: null },
            select: { name: true },
            orderBy: { order: "asc" },
          }).then((rows) => rows.map((r) => r.name)),
      prisma.teamResult.findMany({
        where: { eventId: event.id },
        select: { name: true, members: { select: { name: true }, orderBy: { order: "asc" } } },
      }),
    ]);
    const playerCount = playerNames.length;
    const spotsLeft = Math.max(0, event.maxPlayers - playerCount);
    title = `${event.title} — Convocados`;
    description = `${event.location || "Game"} · ${playerCount}/${event.maxPlayers} players · ${spotsLeft} spot(s) left`;

    // ADR 0034: the page is a client-only shell, so the head is the only part
    // an agent that does not run JS can read. Emit structured data for every
    // link-accessible event and always advertise the JSON representation.
    const head = generateEventHead({
      id: event.id,
      title: event.title,
      location: event.location,
      dateTime: event.dateTime,
      sport: event.sport,
      maxPlayers: event.maxPlayers,
      playerCount,
      url: canonicalUrl,
      accessPassword: event.accessPassword,
    });
    jsonLd = head.jsonLd ?? "";
    alternateJson = head.alternateJson;

    const activeNames = new Set(playerNames);
    summary = buildEventSummary({
      id: event.id,
      title: event.title,
      location: event.location,
      dateTime: event.dateTime,
      sport: event.sport,
      maxPlayers: event.maxPlayers,
      playerCount,
      playerNames,
      teams: teamRows
        .map((t) => ({ name: t.name, members: t.members.map((m) => m.name).filter((n) => activeNames.has(n)) }))
        .filter((t) => t.members.length > 0),
      locked: !!event.accessPassword,
    });

    metaTags = generateEventMetaTags({
      title: event.title,
      description,
      url: canonicalUrl,
      dateTime: event.dateTime,
      location: event.location,
      playerCount,
      maxPlayers: event.maxPlayers,
    });
  }
} catch { /* SSR meta is best-effort */ }
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
  alternateJson={alternateJson}
  metaTags={metaTags}
  mainTransitionName={`page-event-${id}`}
>
  {summary && (
    <section
      data-ssr-event-summary
      aria-label="Event summary"
      style="max-width: 720px; margin: 0 auto; padding: 24px 16px; font-family: system-ui, sans-serif; line-height: 1.6; color: #e6e6e6;"
    >
      <h1 style="font-size: 1.5rem; margin: 0 0 8px;">{summary.heading}</h1>
      <p style="margin: 0 0 4px;">{summary.meta}</p>
      <p style="margin: 0 0 4px;">{summary.attendance}</p>
      {summary.players && <p style="margin: 0 0 4px;">Players: {summary.players}</p>}
      {summary.teams.map((team) => (
        <p style="margin: 0 0 4px;">{team.name}: {team.members.join(", ")}</p>
      ))}
      <p style="margin: 8px 0 0; opacity: 0.7;">
        Machine-readable: <a href={summary.apiPath} style="color: #7fc7a4;">{summary.apiPath}</a> (JSON)
      </p>
    </section>
  )}
  <EventPageComponent client:only="react" eventId={id!} />
</BaseLayout>
