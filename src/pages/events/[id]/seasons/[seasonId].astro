---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SeasonPage from "../../../../components/SeasonPage";

const { id, seasonId } = Astro.params;
const crewInviteToken = Astro.url.searchParams.get("crewInviteToken");
const title = "Season — Convocados";
---

<BaseLayout title={title} description="Manage Season Crews and starting date.">
  <SeasonPage client:only="react" eventId={id!} seasonId={seasonId!} crewInviteToken={crewInviteToken ?? undefined} />
</BaseLayout>
