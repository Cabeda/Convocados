{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/*": ["./src/*"],
      "@prisma/client": ["./src/lib/prisma-client"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "e2e", "mobile", "prisma.config.ts", "src/test/oauth-schema.test.ts", "src/test/oauth-token-endpoints.test.ts", "src/test/oauth-e2e.test.ts", "src/test/oauth-authenticate.test.ts", "src/test/auth-helpers.test.ts", "src/test/teams-api.test.ts"]
}
